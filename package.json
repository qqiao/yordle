    "@open-wc/eslint-config": "^13.1.0",
    "@types/gulp": "^4.0.18",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "gulp": "^5.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@lit/localize": "^0.12.2",
    "@lit/task": "^1.0.3",
    "@material/web": "^2.5.0",
    "lit": "^3.3.3",
    "pwa-helpers": "^0.9.1"
  },
  "scripts": {
    "i18n:extract": "lit-localize extract",
    "i18n:build": "lit-localize build",
    "format": "eslint . --fix && prettier \"**/*.(cjs|mjs|ts|mts)\" --write",
    "build": "yarn clean && yarn i18n:build && vite build && gulp copy",
    "clean": "rimraf dist/ out-tsc/",
    "deploy": "yarn build && gulp deploy",
    "start": "yarn build && gulp",
    "test": "yarn test:frontend && gulp test",
    "test:frontend": "node --test test/frontend/short-url.test.mts"
  },
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "@xmldom/xmldom": "0.8.13",
    "lit": "^3.3.3"
  }
